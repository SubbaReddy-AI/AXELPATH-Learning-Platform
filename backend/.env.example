# ============================================================
# AXELPATH Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

APP_NAME=AXELPATH Learning Platform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS

# Database
DATABASE_URL=mysql+mysqlconnector://axelpath:Password@mysql:3306/axelpath_db

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHAR
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin
ADMIN_EMAIL=axelpathofficial@gmail.com
ADMIN_DEFAULT_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# CORS
ALLOWED_ORIGINS=https://axelpath-learning-platform.vercel.app,http://localhost:5173,http://localhost:3000
# Cloudflare R2 / S3-compatible object storage
# Keep false until your R2 account and credentials are ready.
R2_ENABLED=false
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=axelpath
R2_REGION=auto
R2_SIGNED_URL_EXPIRE_SECONDS=900

# Media Storage
MEDIA_ROOT=../media
MAX_UPLOAD_SIZE_MB=1000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@axelpath.com
SMTP_FROM_NAME=AXELPATH Platform
MAIL_TLS=true
MAIL_SSL=false

# Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_PERIOD_SECONDS=900

# Cleanup
CLEANUP_JOB_HOUR=2
CLEANUP_JOB_MINUTE=0
CLEANUP_ENABLED=true

# Learning content cycle / 45-recording rule
RECORDINGS_PER_CYCLE=45
RETENTION_WORKING_DAYS=15
USE_RECORDING_COUNT_FOR_CLEANUP=true
USE_WORKING_DAYS=true
DELETE_RECORDING_MEDIA=true
DELETE_RECORDING_THUMBNAILS=true
DELETE_ASSIGNMENT_MEDIA=true
DELETE_QUIZ_QUESTIONS=false
DELETE_QUIZ_ATTEMPTS=true
DELETE_QUIZ_REPORTS=true

# Preserve student progress
PRESERVE_STUDENT_ACCOUNTS=true
PRESERVE_VIDEO_PROGRESS=true
PRESERVE_RESUME_POSITION=true
PRESERVE_COMPLETION_STATUS=true
PRESERVE_ASSIGNMENT_STATUS=true
PRESERVE_QUIZ_STATUS=true
PRESERVE_OVERALL_PROGRESS=true
PRESERVE_PROGRESS_SUMMARY=true
PRESERVE_DOMAIN_ACCESS_HISTORY=true
PRESERVE_ADMIN_PROGRESS_REPORTS=true

# Assignment retention: 45 days + 15 additional days
ASSIGNMENT_RETENTION_DAYS=45
ASSIGNMENT_EXTRA_RETENTION_DAYS=15

# Security cookies
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# File validation
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm,.mov
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.zip
ALLOWED_CODE_EXTENSIONS=.py,.java,.c,.cpp,.js,.sql,.html,.css

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/axelpath.log

# Backup
BACKUP_ENABLED=true
BACKUP_DIRECTORY=../backups

# Frontend / timezone
FRONTEND_URL=https://axelpath-learning-platform.vercel.app
TIMEZONE=Asia/Kolkata

# Deadline reminders
# QUIZ: 12 hours before only
# ASSIGNMENT: 12 hours before only
# PROJECT: 20 days, 10 days, and 12 hours before
REMINDER_JOB_HOUR=9
REMINDER_JOB_MINUTE=0
REMINDER_DAYS_BEFORE=20,10
REMINDER_HOURS_BEFORE=12

# Google Sheets — student details only
GOOGLE_SPREADSHEET_ID=1Yw7fTNdGq47tFopaRbPF_ICTLN2rmZPW_gO_erLeG48
GOOGLE_SHEET_WORKSHEET=Sheet2
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
